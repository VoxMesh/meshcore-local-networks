{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VoxMesh/meshcore-local-networks/main/schema.json",
  "title": "MeshCore local networks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated",
    "locations"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "radio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency_hz",
        "bandwidth_hz",
        "sf",
        "cr"
      ],
      "properties": {
        "frequency_hz": {
          "type": "integer",
          "minimum": 1
        },
        "bandwidth_hz": {
          "type": "integer",
          "minimum": 1
        },
        "sf": {
          "type": "integer",
          "minimum": 5,
          "maximum": 12
        },
        "cr": {
          "type": "integer",
          "enum": [
            5,
            6,
            7,
            8
          ]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "radio",
        "updated"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "radio": {
          "$ref": "#/$defs/radio"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "community_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "country",
        "region",
        "lat",
        "lon",
        "networks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "parent_id": {
          "$ref": "#/$defs/id"
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/network"
          }
        }
      }
    }
  }
}
